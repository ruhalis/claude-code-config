{
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet",
    "MCP_TIMEOUT": "90000",
    "CAD_TELEMETRY": "0"
  },
  "enableWorkflows": true,
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline/statusline.sh"
  },
  "enabledPlugins": {
    "clangd-lsp@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "cloudflare@cloudflare": true,
    "data@knowledge-work-plugins": true,
    "design@knowledge-work-plugins": true,
    "desktop-commander@claude-plugins-official": true,
    "document-skills@anthropic-agent-skills": true,
    "engineering@knowledge-work-plugins": true,
    "frontend-design@claude-plugins-official": true,
    "kicad-happy@kicad-happy": true,
    "nvidia-skills@claude-plugins-official": true,
    "pdf-viewer@knowledge-work-plugins": true,
    "pyright-lsp@claude-plugins-official": true,
    "rea@rea": true,
    "session-report@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "text-to-cad@earthtojake": true
  },
  "extraKnownMarketplaces": {
    "earthtojake": {
      "source": {
        "source": "github",
        "repo": "earthtojake/text-to-cad",
        "ref": "latest"
      }
    },
    "kicad-happy": {
      "source": {
        "source": "github",
        "repo": "aklofas/kicad-happy"
      },
      "autoUpdate": true
    },
    "knowledge-work-plugins": {
      "source": {
        "source": "github",
        "repo": "anthropics/knowledge-work-plugins"
      },
      "autoUpdate": true
    },
    "anthropic-agent-skills": {
      "source": {
        "source": "github",
        "repo": "anthropics/skills"
      },
      "autoUpdate": true
    },
    "cloudflare": {
      "source": {
        "source": "github",
        "repo": "cloudflare/skills",
        "ref": "cbf893b954222276bf1af57e5f23379231e0efb9"
      }
    },
    "rea": {
      "source": {
        "source": "github",
        "repo": "morluto/rea",
        "ref": "5d1a47768aa0ff43077758db57f9e99e9f3034a9"
      }
    }
  },
  "syncClaudeAiPlugins": false,
  "syncClaudeAiSkills": false,
  "deniedMcpServers": [
    { "serverName": "plugin:data:snowflake" },
    { "serverName": "plugin:data:databricks" },
    { "serverName": "plugin:data:bigquery" },
    { "serverName": "plugin:data:hex" },
    { "serverName": "plugin:data:amplitude" },
    { "serverName": "plugin:data:amplitude-eu" },
    { "serverName": "plugin:data:atlassian" },
    { "serverName": "plugin:data:definite" },
    { "serverName": "plugin:design:slack" },
    { "serverName": "plugin:design:figma" },
    { "serverName": "plugin:design:linear" },
    { "serverName": "plugin:design:asana" },
    { "serverName": "plugin:design:atlassian" },
    { "serverName": "plugin:design:notion" },
    { "serverName": "plugin:design:intercom" },
    { "serverName": "plugin:design:google calendar" },
    { "serverName": "plugin:design:gmail" },
    { "serverName": "plugin:engineering:slack" },
    { "serverName": "plugin:engineering:linear" },
    { "serverName": "plugin:engineering:asana" },
    { "serverName": "plugin:engineering:atlassian" },
    { "serverName": "plugin:engineering:notion" },
    { "serverName": "plugin:engineering:github" },
    { "serverName": "plugin:engineering:pagerduty" },
    { "serverName": "plugin:engineering:datadog" },
    { "serverName": "plugin:engineering:google calendar" },
    { "serverName": "plugin:engineering:gmail" }
  ],
  "advisorModel": "fable",
  "skillListingBudgetFraction": 0.02,
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "xhigh"
    },
    "claude-fable-5-2": {
      "effortLevel": "high"
    }
  },
  "skipWorkflowUsageWarning": true,
  "workflowKeywordTriggerEnabled": false,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "remoteControlAtStartup": true,
  "subagentStatusLine": {
    "type": "command",
    "command": "~/.claude/subagent-statusline.sh"
  },
  "subagentPromptCacheTtl": "1h",
  "permissions": {
    "deny": [
      "Bash(git commit *)",
      "Bash(git commit)",
      "Bash(git -C * commit *)",
      "Bash(git push *)",
      "Bash(git push)",
      "Bash(git -C * push *)",
      "Bash(gh pr create *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git cherry-pick *)",
      "Bash(git revert *)",
      "Bash(git tag *)",
      "Bash(git add -A *)",
      "Bash(git add --all *)",
      "Bash(git add -u *)",
      "Bash(git add --update *)",
      "Bash(git add .)",
      "Bash(git add . *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git *push* --force*)",
      "Bash(git *push* -f*)",
      "Bash(git *push* +*)",
      "mcp__plugin_desktop-commander_desktop-commander__start_process",
      "mcp__plugin_desktop-commander_desktop-commander__interact_with_process",
      "mcp__plugin_desktop-commander_desktop-commander__write_file",
      "mcp__plugin_desktop-commander_desktop-commander__write_pdf",
      "mcp__plugin_desktop-commander_desktop-commander__edit_block",
      "mcp__plugin_desktop-commander_desktop-commander__move_file",
      "Bash(git reset --hard *)",
      "Bash(git clean -fd *)",
      "Bash(git clean -fdx *)",
      "Bash(rm -rf ~ *)",
      "Bash(rm -rf / *)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf /)",
      "Skill(text-to-cad:pcb)",
      "Skill(text-to-cad:pcb *)",
      "Skill(text-to-cad:sendcutsend)",
      "Skill(text-to-cad:sendcutsend *)",
      "Skill(kicad-happy:kicad)",
      "Skill(kicad-happy:kicad *)",
      "Skill(kicad-happy:pcbway)",
      "Skill(kicad-happy:pcbway *)",
      "Skill(cloudflare:basin)",
      "Skill(cloudflare:basin *)",
      "Skill(cloudflare:k2)",
      "Skill(cloudflare:k2 *)",
      "Skill(cloudflare:gateway-workers)",
      "Skill(cloudflare:gateway-workers *)",
      "Skill(cloudflare:cloudflare-one-migrations)",
      "Skill(cloudflare:cloudflare-one-migrations *)",
      "Skill(cloudflare:sandbox-stable)",
      "Skill(cloudflare:sandbox-stable *)",
      "Skill(cloudflare:sandbox-next)",
      "Skill(cloudflare:sandbox-next *)",
      "Skill(cloudflare:sandbox-migrate-to-next)",
      "Skill(cloudflare:sandbox-migrate-to-next *)"
    ],
    "ask": [
      "mcp__plugin_rea_rea__*",
      "mcp__plugin_cloudflare_cloudflare__execute",
      "mcp__plugin_desktop-commander_desktop-commander__create_directory",
      "mcp__plugin_desktop-commander_desktop-commander__set_config_value",
      "mcp__plugin_desktop-commander_desktop-commander__kill_process",
      "mcp__plugin_desktop-commander_desktop-commander__force_terminate"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/guard-main-session.sh",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/guard-git-write.sh",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Edit|Write|Bash|mcp__.*[Kk][Ii][Cc][Aa][Dd].*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/guard-kicad-edit.sh",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
