{
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet",
    "CADGEN_TELEMETRY": "0",
    "CADGEN_UPDATE_CHECK": "0"
  },
  "enableWorkflows": true,
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline/statusline.sh"
  },
  "enabledPlugins": {
    "clangd-lsp@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "kicad-happy@kicad-happy": true,
    "text-to-cad@earthtojake": true
  },
  "extraKnownMarketplaces": {
    "kicad-happy": {
      "source": {
        "source": "github",
        "repo": "aklofas/kicad-happy"
      }
    },
    "earthtojake": {
      "source": {
        "source": "github",
        "repo": "earthtojake/text-to-cad",
        "ref": "latest"
      }
    }
  },
  "syncClaudeAiPlugins": false,
  "advisorModel": "opus",
  "effortLevel": "xhigh",
  "modelSettings": {
    "claude-opus-5": {
      "effortLevel": "xhigh"
    },
    "claude-opus-5-5": {
      "effortLevel": "high"
    },
    "claude-fable-5-1": {
      "effortLevel": "high"
    }
  },
  "skipWorkflowUsageWarning": true,
  "workflowKeywordTriggerEnabled": false,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "remoteControlAtStartup": true,
  "subagentStatusLine": {
    "type": "command",
    "command": "~/.claude/subagent-statusline.sh"
  },
  "subagentPromptCacheTtl": "1h",
  "permissions": {
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git *push* --force*)",
      "Bash(git *push* -f*)",
      "Bash(git *push* +*)",
      "mcp__plugin_desktop-commander_desktop-commander__start_process",
      "mcp__plugin_desktop-commander_desktop-commander__interact_with_process",
      "Bash(git reset --hard *)",
      "Bash(git clean -fd *)",
      "Bash(git clean -fdx *)",
      "Bash(rm -rf ~ *)",
      "Bash(rm -rf / *)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf /)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/guard-main-session.sh",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
