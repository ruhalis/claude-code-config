{
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet",
    "MCP_TIMEOUT": "90000",
    "CAD_TELEMETRY": "0"
  },
  "enableWorkflows": true,
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline/statusline.sh"
  },
  "enabledPlugins": {
    "clangd-lsp@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "hyperframes@hyperframes": true,
    "kicad-happy@kicad-happy": true,
    "text-to-cad@text-to-cad": true
  },
  "extraKnownMarketplaces": {
    "kicad-happy": {
      "source": {
        "source": "github",
        "repo": "aklofas/kicad-happy"
      },
      "autoUpdate": true
    },
    "hyperframes": {
      "source": {
        "source": "github",
        "repo": "heygen-com/hyperframes"
      }
    }
  },
  "syncClaudeAiPlugins": false,
  "syncClaudeAiSkills": false,
  "advisorModel": "fable",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    },
    "claude-fable-5-2": {
      "effortLevel": "high"
    }
  },
  "skipWorkflowUsageWarning": true,
  "workflowKeywordTriggerEnabled": false,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "remoteControlAtStartup": true,
  "subagentStatusLine": {
    "type": "command",
    "command": "~/.claude/subagent-statusline.sh"
  },
  "subagentPromptCacheTtl": "1h",
  "permissions": {
    "deny": [
      "Bash(git commit *)",
      "Bash(git commit)",
      "Bash(git -C * commit *)",
      "Bash(git push *)",
      "Bash(git push)",
      "Bash(git -C * push *)",
      "Bash(gh pr create *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git *push* --force*)",
      "Bash(git *push* -f*)",
      "Bash(git *push* +*)",
      "mcp__plugin_desktop-commander_desktop-commander__start_process",
      "mcp__plugin_desktop-commander_desktop-commander__interact_with_process",
      "Bash(git reset --hard *)",
      "Bash(git clean -fd *)",
      "Bash(git clean -fdx *)",
      "Bash(rm -rf ~ *)",
      "Bash(rm -rf / *)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf /)",
      "Skill(text-to-cad:pcb)",
      "Skill(text-to-cad:pcb *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/guard-main-session.sh",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Edit|Write|Bash|mcp__.*[Kk][Ii][Cc][Aa][Dd].*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/guard-kicad-edit.sh",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
